---
import BaseLayout from '../layouts/BaseLayout.astro';

// The support console runs on the Cabinet platform server and is reached through the demo gate.
// This page is the front door on the custom domain: it hands the browser straight over.
const CONSOLE_URL = 'https://srv1522777.tail72f980.ts.net:10000';
---

<BaseLayout
  title="Cabinet Support Console — Marco Fernstaedt"
  description="Live demo of the Cabinet diagnostics console: fleet inventory, approved diagnostics, and enrollment."
>
  <section class="hero" aria-labelledby="console-h" style="border-top:none;">
    <div class="wrap">
      <p class="mono">Live demo</p>
      <h1 id="console-h">Cabinet support console</h1>
      <p>
        The console is opening on its own address. It asks for the demo access code, then shows the
        fleet, the machines waiting for enrollment approval, and the diagnostics each agent reports.
      </p>
      <p>
        <a class="btn primary" href={CONSOLE_URL}>Open the console</a>
        <a class="btn ghost" href="/#dev-projects">Back to projects</a>
      </p>
      <p class="mono">The agents connect out over mutual TLS. Nothing connects inbound to a cabinet.</p>
      <script is:inline define:vars={{ CONSOLE_URL }}>
        window.location.replace(CONSOLE_URL);
      </script>
    </div>
  </section>
</BaseLayout>
